# --- Data ingestion (Railway worker) ---
FRED_API_KEY=                     # api.stlouisfed.org key (required)
CFTC_APP_TOKEN=                   # optional socrata app token

# --- Infrastructure ---
SUPABASE_URL=                     # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE=            # service-role key (server-side only; RLS internal-only)
REDIS_URL=                        # Upstash Redis (rediss://default:<pass>@<host>:<port>)

# --- Delivery ---
SLACK_BOT_TOKEN=                  # existing bot; posts to #all-ekantikcapital
SLACK_CHANNEL_ID=C0AH7FWP2JU
ANTHROPIC_API_KEY=                # optional — narrative paragraph in sentinel message 3

# --- Portal ---
CRON_SECRET=                      # Vercel Cron authorization bearer
ADMIN_API_KEY=                    # x-admin-key for the admin drawer routes
